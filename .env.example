# Required for upload API (send as header X-Upload-Token only)
UPLOAD_TOKEN=change-me

# Server
PORT=8787
HOST=127.0.0.1

# Published pages always use:
# https://trueid-confluence-source.signalbay.fyi/pages/<path>/

# Git deploy (push to main triggers Pages / Cloudflare)
GIT_DEPLOY=true
GIT_BRANCH=main
GIT_REMOTE=origin
