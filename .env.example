# Required for upload API (send as header X-Upload-Token only)
UPLOAD_TOKEN=change-me

# Server
PORT=8787
HOST=127.0.0.1

# Public site base used in iframe snippets after deploy (no trailing slash)
# Examples:
# PUBLIC_BASE_URL=https://sebbersky.github.io/trueid-confluence-source
# PUBLIC_BASE_URL=https://your-project.pages.dev
PUBLIC_BASE_URL=

# Git deploy (push to main triggers Pages / Cloudflare)
GIT_DEPLOY=true
GIT_BRANCH=main
GIT_REMOTE=origin
# Optional override; defaults to "portal: add pages/<path>"
# GIT_COMMIT_PREFIX=portal:
